{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "USER_MINUTE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "USER_BURST", "namespace_id": "1002", "simple": { "limit": 2, "period": 10 } },
    { "name": "IP_MINUTE", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "GUEST_MINUTE", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } },
    { "name": "GUEST_BURST", "namespace_id": "1005", "simple": { "limit": 1, "period": 10 } }
  ]
}
